# Render Environment Variables
# Copy these keys and values into your Render dashboard Web Service settings.

# 1. Server Configuration
PORT=8080

# 2. Database Configuration (Aiven MySQL example)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-host-here:12964/defaultdb?useSSL=true&requireSSL=true&verifyServerCertificate=false
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_database_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 3. Security (JWT Settings)
JWT_SECRET=RentMyVehicleSuperSecretKeyWhichMustBeAtLeast256BitsLongForHmacSha256Algorithm
JWT_EXPIRATION=86400000

# 4. CORS Allowed Origins (Set to your Vercel frontend URL, comma-separated if multiple)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# 5. Google Cloud Storage Config
GCS_BUCKET_NAME=rent-my-vehicle-assets
GCS_CREDENTIALS_PATH=google-credentials.json
# Raw JSON contents of your GCS service account credentials file:
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-project-id", ...}

# 6. Spring Mail SMTP Configuration (Gmail example)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
# Use Google App Password (not your primary password) if 2FA is active:
SPRING_MAIL_PASSWORD=your_gmail_app_password_here

# 7. Razorpay Test Credentials (Optional - Defaults to Mock Checkout if omitted)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
